# Sao chép file này thành `.env.local` rồi chỉnh theo môi trường của bạn.
#
# Base URL của backend = <host>:<SERVER_PORT><API_PREFIX>.
# Theo file .env của backend: SERVER_PORT=8080, API_PREFIX=/api/v1
#
# LƯU Ý CORS: SecurityConfig của backend chỉ cho phép origin
#   http://localhost:5173  (Vite mặc định)
#   http://localhost:3000
# Chạy FE ở port khác sẽ bị trình duyệt chặn.
VITE_API_BASE_URL=http://localhost:8080/api/v1
