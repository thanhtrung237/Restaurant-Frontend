# Sao chép file này thành `.env.local` rồi chỉnh theo môi trường của bạn.
#
# Vite chuyển tiếp /api/v1 và /ws tới backend trong môi trường phát triển.
# Chỉ đổi nếu backend dùng host hoặc cổng khác.
# DEV_BACKEND_ORIGIN=http://127.0.0.1:8080

# Bật HTTPS cho Vite bằng chứng chỉ có tên miền hoặc IP mà điện thoại truy cập.
# DEV_HTTPS_CERT=./certs/lan.pem
# DEV_HTTPS_KEY=./certs/lan-key.pem

# Đặt khi bản triển khai dùng địa chỉ API riêng hoặc reverse proxy.
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Hostname bổ sung cho cổng Quản trị nền tảng (không gồm https:// hoặc đường dẫn).
# platform-admin.thanhtrung.click được nhận diện sẵn.
# VITE_PLATFORM_HOSTNAME=admin.example.com
